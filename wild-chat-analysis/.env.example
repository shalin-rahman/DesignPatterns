# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible Chat Completions provider works. Groq shown here.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1000
LLM_REQUEST_TIMEOUT=60
# Requests per minute sent to the API (0 = no limit). Groq free tier is about 30.
LLM_REQUESTS_PER_MINUTE=30
# Ask the provider for JSON-only output (response_format=json_object).
LLM_JSON_MODE=true
# Only needed by some providers (for example OpenAI):
# LLM_ORGANIZATION=
# LLM_PROJECT=
# Only needed if the Hugging Face dataset asks you to log in:
# HF_TOKEN=

# Fallback: Hugging Face Inference Providers (OpenAI-compatible). Same model keeps labels consistent.
# To switch, put "#" in front of the Groq LLM_API_KEY / LLM_BASE_URL lines above and remove it below.
# The token needs the "Make calls to Inference Providers" permission.
# LLM_API_KEY=hf_...
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=openai/gpt-oss-120b
