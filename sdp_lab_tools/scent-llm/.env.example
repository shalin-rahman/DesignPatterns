# Copy this file to .env and fill in only the providers you use.
# .env is gitignored - never commit real keys.
# scent-llm loads .env from the current working directory automatically;
# a real shell/CI environment variable always takes priority over .env.

# Which provider generate/analyze should use: ollama | groq | gemini | openrouter
SCENT_LLM_PROVIDER=ollama
SCENT_LLM_MODEL=
SCENT_LLM_TEMPERATURE=
SCENT_LLM_MAX_TOKENS=

# Ollama (local, no key needed)
OLLAMA_HOST=http://localhost:11434

# Groq (cloud) - get a key at console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (cloud) - get a key at Google AI Studio
GEMINI_API_KEY=

# OpenRouter (cloud) - get a key at openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
